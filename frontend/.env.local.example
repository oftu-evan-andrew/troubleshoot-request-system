# Local development (running both servers on your own machine):
NEXT_PUBLIC_API_BASE_URL=http://localhost:5242

# LAN deployment (frontend served to lab PCs over the network) — point this
# at the server's actual LAN hostname instead, so every browser on the LAN
# reaches the same machine rather than resolving "localhost" to itself:
# NEXT_PUBLIC_API_BASE_URL=http://labsupport.local:5242
